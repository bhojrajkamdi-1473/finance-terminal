# Optional — enables financial statements + valuation ratios.
# Free tier: 25 requests/day, delayed. Last-resort quote leg.
# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Alias (either name works):
# FUNDAMENTALS_API_KEY=

# Optional — middle fallback leg for quotes/history/search.
# Free Basic: 8 credits/min, 800/day. Claims real-time US
# equities/ETFs, forex, crypto; other markets delayed or uncovered.
# NOTE (verified live): Twelve Data has NO NSE/BSE coverage on the
# free plan — Indian symbols must rely on the indian-api leg.
# Get a free key at https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# Indian Stock Market API: FREE, no key required (MIT upstream v3.0).
# NSE/BSE quote + market fundamentals (market cap, P/E, EPS, book
# value, dividend yield, sector, industry, 52W range) with no
# authentication. No statements/estimates/ownership from this feed.
# (Legacy INDIAN_STOCK_MARKET_API_KEY is obsolete and ignored.)

# SQLite storage location (default ./terminal-data/terminal.db)
TERMINAL_DB=terminal-data/terminal.db

# Server bind (default 0.0.0.0 so hosted deploys are reachable)
TERMINAL_HOST=0.0.0.0
PORT=8000
