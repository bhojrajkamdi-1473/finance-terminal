# Optional — enables financial statements + valuation ratios.
# Free tier: 25 requests/day, delayed. Last-resort quote leg.
# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Alias (either name works):
# FUNDAMENTALS_API_KEY=

# Optional — middle fallback leg for quotes/history/search.
# Free Basic: 8 credits/min, 800/day. Claims real-time US
# equities/ETFs, forex, crypto; other markets delayed or uncovered.
# NOTE (verified live): Twelve Data has NO NSE/BSE coverage on the
# free plan — Indian symbols must rely on the indian-api leg.
# Get a free key at https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# Indian Stock Market API: keyed NSE/BSE leg (x-api-key header).
# With a key: quote, statements, history, stats, actions, news,
# forecasts, targets, ownership for .NS/.BO symbols.
# Without a key: free no-auth fallback covers quote + market
# fundamentals (market cap, P/E, EPS, book value, dividend yield,
# sector, industry, 52W range) only.
# Get a key from the official Indian Stock Market API portal.
INDIAN_STOCK_MARKET_API_KEY=

# AI research engine (server-side only — keys never reach the browser).
# Without these, the terminal works normally and AI Research reports
# "LLM provider not configured". OpenAI-compatible endpoint default.
# AI_PROVIDER= openai | anthropic | openrouter | ollama | azure | off
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# Optional endpoint override (OpenAI-compatible chat completions).
# AI_BASE_URL=
# Optional per-call LLM timeout seconds (default 45).
# AI_TIMEOUT_S=45

# SQLite storage location (default ./terminal-data/terminal.db)
TERMINAL_DB=terminal-data/terminal.db

# Server bind (default 0.0.0.0 so hosted deploys are reachable)
TERMINAL_HOST=0.0.0.0
PORT=8000
